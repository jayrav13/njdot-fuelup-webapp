# Copy to .env.local (gitignored) and fill in. Never commit real keys.

# Optional: Google Maps JavaScript API key for the embedded maps.
# Restrict it to HTTP referrers in Google Cloud; it is visible to browsers.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: your own Map ID for styled/advanced markers (defaults to DEMO_MAP_ID).
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Optional: libSQL/SQLite database URL (defaults to file:data/fuelup.db).
# DATABASE_URL=file:data/fuelup.db
